# ─── Application ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ───────────────────────────────────────────────────
# SQLite (default). Change to postgresql+psycopg2://... for Postgres.
DATABASE_URL=sqlite:///./qa_backend.db

# ─── Paths ──────────────────────────────────────────────────────
DATA_DIR=data
LLM_OUTPUT_DIR=llm_outputs

# ─── OpenRouter LLM ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Free models: google/gemini-flash-1.5, meta-llama/llama-3-8b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── LLM behaviour ──────────────────────────────────────────────
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=60
PROMPT_VERSION=v1
